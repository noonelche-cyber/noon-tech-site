  "icon": "calendar",
  "color": "#E6DBF2",
  "baseType": "custom",
  "fields": [
    {
      "id": "action",
      "label": "À faire",
      "type": "text",
      "default": ""
    },
    {
      "id": "echeance",
      "label": "Échéance",
      "type": "datetime-local",
      "default": ""
    },
    {
      "id": "repetition",
      "label": "Répétition souhaitée",
      "type": "text",
      "default": "Aucune"
    },
    {
      "id": "etat",
      "label": "État",
      "type": "text",
      "default": "À faire"
    },
    {
      "id": "notes",
      "label": "Notes",
      "type": "text",
      "default": ""
    }
  ]
